{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battleship-mini-demo",
  "main": "src/adapters/cloudflare/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_REGISTRY",
        "class_name": "AdminRegistry"
      },
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AdminRegistry", "GameRoom"]
    }
  ],
  "env": {
    "dev": {
      "name": "battleship-mini-demo-dev",
      "durable_objects": {
        "bindings": [
          {
            "name": "ADMIN_REGISTRY",
            "class_name": "AdminRegistry"
          },
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      }
    }
  }
}
